{
  "expo": {
    "name": "Cricket Live Line",
    "slug": "cricket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash_logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#022C22"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.keyur.cricket",
      "adaptiveIcon": {
        "backgroundColor": "#022C22",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-font"
    ]
  }
}
